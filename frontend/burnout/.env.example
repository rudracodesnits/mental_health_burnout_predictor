# WellCheck — Environment Variables

# Copy this file to .env and fill in your values

# Clerk authentication (required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL (optional — defaults to http://127.0.0.1:5000 for local dev)
VITE_API_BASE_URL=http://127.0.0.1:5000

# Admin dashboard PIN (optional — defaults to 'admin1234')
VITE_ADMIN_PIN=admin1234
